rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Math Monsters (multiplication game) player docs
    match /players/{playerId} {
      allow read, create, delete: if true;
      allow update: if true;
    }
    // Monsters of Mathland (addition/subtraction game) player docs
    match /mathland_players/{playerId} {
      allow read, create, delete: if true;
      allow update: if true;
    }
  }
}
